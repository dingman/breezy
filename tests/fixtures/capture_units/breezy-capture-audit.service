# TEST FIXTURE ONLY (AUT-1 WP5 stage 3, D1/D12): never linked into the user manager.
# The studies lock is taken IN PROCESS (no flock in front of the wrapper), so the wait cannot age
# the bus snapshot. ExecStart's timeout 1470 = AUDIT_EXEC_TIMEOUT_S; pre lines 5 + 5 + 15 = 25.
[Unit]
Description=Breezy AUT-1 capture audit (user scope, sandboxed)
OnFailure=breezy-autonomy-failed@%n.service
OnSuccess=breezy-capture-live-proof.service

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy
Slice=breezy-studies.slice
UMask=0077
MemoryHigh=768M
MemoryMax=1G
TimeoutStartSec=1500
TimeoutStopSec=5
ExecStartPre=/usr/bin/timeout -k 1 4 /usr/bin/install -d -m 0700 %h/.local/share/breezy/evidence/capture/audit %h/.local/share/breezy/evidence/capture/heal %h/.local/share/breezy/evidence/capture/heal_alert_abandoned %h/.local/share/breezy/derived/verdicts %h/.local/share/breezy/cache/capture_audit %h/.local/share/breezy/cache/capture_audit_bus
ExecStartPre=-/usr/bin/timeout -k 1 4 /usr/bin/touch %t/breezy-studies.lock
ExecStartPre=-/usr/bin/timeout -k 2 13 /home/jon/breezy/deploy/systemd/breezy-autonomy-bwrap --bus-snapshot breezy-capture-audit
ExecStart=/usr/bin/timeout -k 5 1470 /home/jon/breezy/deploy/systemd/breezy-autonomy-bwrap breezy-capture-audit /home/jon/breezy/.venv/bin/python3 -I -m breezy.analysis.capture_audit_cli
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-capture-audit
