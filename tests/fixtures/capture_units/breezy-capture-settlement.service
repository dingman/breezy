# TEST FIXTURE ONLY (AUT-1 WP5 stage 3, D1/D12): never linked into the user manager. The unit is
# promoted into deploy/systemd/ in stage 4, after AUT-6 lands the OnFailure= notifier row.
[Unit]
Description=Breezy AUT-1 settlement writer (user scope, sandboxed)
OnFailure=breezy-autonomy-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy
UMask=0077
MemoryMax=512M
TimeoutStartSec=300
TimeoutStopSec=5
ExecStartPre=/usr/bin/timeout -k 1 4 /usr/bin/install -d -m 0700 %h/.local/share/breezy/catalog/quote_tape/decisions
ExecStart=/usr/bin/timeout -k 5 290 /usr/bin/flock -w 30 %t/breezy-capture-settlement.lock /home/jon/breezy/deploy/systemd/breezy-autonomy-bwrap breezy-capture-settlement /home/jon/breezy/.venv/bin/python3 -I -m breezy.analysis.capture_settlement_cli --catalog-base %h/.local/share/breezy/catalog
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-capture-settlement
