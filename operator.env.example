# Copy this file to operator.env at the repo root. Fill in the three values.
# Never commit operator.env. Only these three keys belong here; live-trading
# enablement and every other setting stay in the launch shell.
BREEZY_MAX_DAILY_BUDGET_USD=<unset>
BREEZY_MAX_POSITION_COST_USD=<unset>
BREEZY_MAX_MONTHLY_BUDGET_USD=<unset>
