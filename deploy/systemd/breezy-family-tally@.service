[Unit]
# WP-11b (active-family registry, cardinality-1): ONE instantiated template
# replaces the per-family unit copies this repo used to carry
# (breezy-pm-crh-cont-tally.service, breezy-pm-crh-v2-tally.service). The
# systemd instance name (%i) IS the family id, passed to the wrapper
# (deploy/systemd/family-tally-v2-run.sh) as its one positional argument --
# never inferred, never duplicated per family. Promoting a new family to
# tally (e.g. a forecast-ladder revision, WP-15/WP-30) is
# `systemctl --user enable --now breezy-family-tally@<family_id>.timer`;
# this unit file itself never changes.
Description=Breezy family tally (PREREG v2/v3) -- %i
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/analysis/family_tally_v2.py
Documentation=file:///home/jon/breezy/docs/plans/FAMILY_TALLY_V2_BLUEPRINT_2026-09-04.md
Documentation=file:///home/jon/breezy/docs/plans/FORECAST_TO_LEARNING_WORK_BREAKDOWN_2026-09-18.md

# AUD-15a: alert on failure (timeout, OOM-kill, or non-zero exit) -- see
# deploy/systemd/breezy-study-failed@.service and its own module docstring.
OnFailure=breezy-study-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy

# Own cgroup memory ceiling -- byte-identical ceiling and rationale to the
# retired per-family units (2026-09-11 breezy-k1-daily.service incident
# follow-up): this unit's own footprint is a local parquet/sqlite read, not
# a tape scan, so MemoryHigh=1G/MemoryMax=2G is deliberately far below the
# host.
MemoryHigh=1G
MemoryMax=2G
UMask=0077

# This unit holds no venue credential -- it reads a local parquet directory,
# a local sqlite exec-state DB, and writes a local Markdown report. It DOES
# alert in-process on a same-day repeat failure
# (emit_family_tally_failure_alert -> resolve_alert_sink/emit_alert,
# scripts/analysis/family_tally_v2.py:1002-1024, wired from
# family-tally-v2-run.sh:330), which is a run that otherwise still exits
# non-zero -- OnFailure=breezy-study-failed@%n.service above also fires --
# but without BREEZY_ALERT_WEBHOOK_URL the in-process alert itself silently
# degrades to journal-only, log-hidden delivery (2026-09-25 units-alerts-env
# audit; tests/unit/test_alerts_env_deploy.py). Same allowlist discipline as
# breezy-portfolio-roi.service: the dedicated, single-key alerts.env file
# (mode 0600, holding just BREEZY_ALERT_WEBHOOK_URL), never breezy-trade.env/
# polymarket.env/operator.env. The `-` prefix keeps the unit startable if the
# file is absent.
EnvironmentFile=-%h/.config/breezy/alerts.env
#
# POLYMARKET_US_EXEC_STATE_DB lives HERE, in the shared TEMPLATE, not on a
# per-instance override: the wrapper unconditionally requires it
# (family-tally-v2-run.sh:213, `${POLYMARKET_US_EXEC_STATE_DB:?...}`) for
# every REGISTERED polymarket_us family, and every family this template is
# ever instantiated for is polymarket_us. WP-0b's own incident -- this line
# present on one then-separate per-family unit and missing on the other --
# is exactly the failure class a single shared template forecloses
# structurally: there is no second copy of this line left to miss.
# Byte-identical value to breezy-score-live-trials.service /
# breezy-live-tally.service's own line.
# (tests/unit/test_family_tally_v2_deploy.py asserts every var the wrapper
# requires for any family it can be instantiated with is present here, not
# skipped merely because this is an uninstantiated template file.)
Environment=POLYMARKET_US_EXEC_STATE_DB=/home/jon/.local/share/breezy/state/exec_polymarket_us.sqlite

ExecStart=/home/jon/breezy/deploy/systemd/family-tally-v2-run.sh %i

# Same budget as the retired per-family units: a local parquet scan plus a
# bootstrap (BCa), well under breezy-mb-daily's network-bound budget.
TimeoutStartSec=600

# No Restart=. A missed daily run is not an incident -- tomorrow's run
# subsumes today's over the still-growing store. The matching timer
# instance's Persistent=true is what recovers a run missed across a reboot.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-family-tally

# NOTE: no [Install] section. An instance of this template is started BY
# its matching `breezy-family-tally@<family_id>.timer` instance, never
# enabled directly -- `systemctl --user enable --now
# breezy-family-tally@<family_id>.timer` is the only thing to enable.
