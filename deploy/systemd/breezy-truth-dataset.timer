[Unit]
Description=12:40 UTC trigger for the Breezy offline AFOS CLI truth dataset
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/archive/iem_cli_fetch.py

[Timer]
Unit=breezy-truth-dataset.service

# 12:40 UTC: an hour after the 11:40 fetch tick, so the day's revision is already
# committed when this reads (ordering is by the clock gap and by the cache, never by
# After=, which does not order units started by separate timers). A fetch that did
# not land leaves yesterday's revision, and the dataset reports the resulting
# coverage_gap rather than hiding it. Free tick; outside the 16:30-17:10Z window.
# No Persistent=true (a catch-up must never replay into that window).
OnCalendar=*-*-* 12:40:00 UTC


AccuracySec=1min

[Install]
WantedBy=timers.target
