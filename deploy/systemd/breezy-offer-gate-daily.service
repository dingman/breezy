[Unit]
# Daily offer-gate scan for CLI-basis candidate #2, triggered by
# breezy-offer-gate-daily.timer. Sibling of breezy-k1-daily.service: same
# oneshot/no-Install/no-EnvironmentFile shape, for the same reason -- this
# process holds no venue credential, opens no socket, and reads only the
# quote tape (forward-only, already on disk) and the settlement-alignment
# ASOS cache (cache-only, zero network -- see the script's module docstring,
# "THE HARD DEPENDENCY: NO LIVE INTRADAY ASOS INGEST").
#
# Item 4 (2026-09-02): an `ExecStartPre=` now refreshes recent ASOS via
# `asos_recent_refresh.py` BEFORE the scan runs -- see that script's module
# docstring for why this is a separate step rather than folded into the
# scan itself (the scan's zero-network guarantee is load-bearing for the
# no-egress test sandbox). This makes `network-online.target` a REAL
# dependency for the refresh half of this unit, unlike before.
Description=Breezy CLI-basis candidate #2 offer-gate scan (daily)
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/analysis/cli_basis_offer_gate_scan.py
Documentation=file:///home/jon/breezy/scripts/analysis/asos_recent_refresh.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy

# Own cgroup memory ceiling. Same 2026-09-11 K1 incident
# (breezy-k1-daily.service hit a 17.6 GB peak in under 2 minutes with no
# ceiling at all, pushing the 31 GB host into swap while
# breezy-trade-supervisor.service -- the live trading node, deliberately
# left UNcapped, see its own :64 comment -- ran at ~625 MB) prompted capping
# every nightly-analysis unit. Measured via `journalctl --user -u
# breezy-offer-gate-daily.service --since 2026-09-08 --no-pager -o cat |
# grep -aoE '[0-9.]+[MG] memory peak'`: the last three completed runs peaked
# at 14.7G, 17.3G, 15.3G over 7-9 min wall clock. MemoryHigh=12G/
# MemoryMax=16G matches the sibling tape studies: well above this unit's
# measured range so ordinary runs are never throttled or killed, and still
# deliberately far below the 31 GB host (node + recorder + tooling together
# measure well under 4G), so a genuine runaway gets OOM-killed in its OWN
# cgroup, never the host-wide OOM killer.
MemoryHigh=12G
MemoryMax=16G

# Shared aggregate ceiling across the nightly studies (see the slice file's
# own comment for why it is usually redundant with the per-unit cap above).
Slice=breezy-studies.slice
UMask=0077

# No EnvironmentFile, deliberately: this scan carries no venue credential and
# defaults both its inputs absolutely
# (scripts/analysis/cli_basis_offer_gate_scan.py:
#  DEFAULT_QUOTE_TAPE_PATH, DEFAULT_ASOS_CACHE_DIR), so it runs on a host with
# no Polymarket.us configuration at all -- same posture as breezy-k1-daily.
#
# ExecStart is deliberately a single plain command with NO shell, NO `$(...)`
# substitution and NO `%`-date-format specifiers: an earlier draft embedded a
# multi-line `/bin/bash -c '...'` driver directly here and `systemd-analyze
# --user verify` printed "Ignoring unknown escape sequences" for it --
# non-empty output, i.e. a FAIL by this repo's own verification convention
# (see deploy/systemd/README.md section 2). A WRAPPER SCRIPT PATH is still a
# single plain command in exactly this sense (breezy-k1-daily.service's own
# ExecStart= is the precedent). `%h` is a systemd-NATIVE specifier (the
# invoking user's home directory, valid in `--user` units), resolved by
# systemd itself rather than by a shell, so it carries none of that risk --
# it is passed to the wrapper as its one required argument.
#
# SP-1 (2026-09-12): the ExecStartPre= ASOS refresh moved INSIDE
# offer-gate-daily-run.sh so the whole run -- refresh AND scan -- sits behind
# the shared studies flock (T3). Trade-off: systemd no longer shows a
# separate ExecStartPre status line for the refresh step; its outcome is
# preserved in the wrapper's own $LOG and, per A-17, also on stdout ->
# journal. The refresh stays fail-soft exactly as before (an UNEXPECTED
# crash never blocks the scan from running on whatever is already cached --
# belt-and-suspenders on top of asos_recent_refresh.py's own fail-soft
# design, never a substitute for it).
ExecStart=/home/jon/breezy/deploy/systemd/offer-gate-daily-run.sh %h/.local/share/breezy/offer_gate

# Mirrors breezy-k1-daily.service's TimeoutStartSec: for Type=oneshot this
# bounds the whole run, and this scan reads a comparable (or smaller) slice
# of the same tape plus a cache-only ASOS read.
TimeoutStartSec=1800

# No Restart=. A missed daily scan is not an incident: the tape and the ASOS
# cache keep growing, and tomorrow's run subsumes today's. The timer's
# Persistent=true is what recovers a run missed across a reboot.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-offer-gate-daily

# NOTE: no [Install] section. This unit is started BY the timer, never
# enabled directly. `systemctl --user enable breezy-offer-gate-daily.timer`
# is the only thing to enable.
