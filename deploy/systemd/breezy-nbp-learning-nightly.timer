[Unit]
Description=02:05 UTC trigger for the Breezy SL-15 NBP nightly learning loop
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/analysis/nbp_learning_nightly.py

[Timer]
Unit=breezy-nbp-learning-nightly.service

# Nightly, away from the existing deploy/systemd/*.timer UTC minute slots and
# after the 01:20 hypothesis triage tick.
OnCalendar=*-*-* 02:05:00 UTC
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
