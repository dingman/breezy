# AUT-6 WP1 (plan r15 section 3.6.3, 3.10; E-7a, E-9, E-15): drain the durable alert outbox.
# Under the shared bwrap wrapper, row breezy-autonomy-alert-redeliver (binds evidence/alerts only,
# egress declared for delivery). The webhook URL arrives only through EnvironmentFile=; it is never
# an Environment= line. The lock file evidence/alerts/.redeliver.lock is created empty (0600) by the
# coordinator at activation and opened O_RDONLY by the CLI; a missing lock is an INTEGRITY exit 3.
#
# Bounds (E-9): TimeoutStartSec re-arms per command. Pre line T + K = 4 + 1 = 5 s; ExecStart
# K + T = 5 + 50 = 55 s; TimeoutStopSec=5. In-process: stop claiming at 40 s, one 5 s attempt.
# OnFailure target: X-3 ships the line before the notifier unit exists (WP4/WP7).
[Unit]
Description=Breezy AUT-6 alert outbox redeliver (every 5 minutes, sandboxed)
OnFailure=breezy-autonomy-failed@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy
UMask=0077
MemoryMax=128M
TimeoutStartSec=55
TimeoutStopSec=5
EnvironmentFile=-%h/.config/breezy/alerts.env
# Configuration, not a control (E-7): this host does not enforce user-unit mount sandboxing. The
# bwrap row is the control.
ReadWritePaths=%h/.local/share/breezy/evidence/alerts
ExecStartPre=/usr/bin/timeout -k 1 4 /usr/bin/install -d -m 0700 %h/.local/share/breezy/evidence/alerts
ExecStart=/usr/bin/timeout -k 5 50 /home/jon/breezy/deploy/systemd/breezy-autonomy-bwrap breezy-autonomy-alert-redeliver /home/jon/breezy/.venv/bin/python3 -I -m breezy.runtime.alert_redeliver_cli
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-autonomy-alert-redeliver
