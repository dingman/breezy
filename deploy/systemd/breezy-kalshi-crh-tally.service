[Unit]
# Daily driver for the PREREG v2 Kalshi sibling tally, family kalshi_crh_v1
# (scripts/analysis/family_tally_v2.py via deploy/systemd/
# family-tally-v2-run.sh), triggered by breezy-kalshi-crh-tally.timer.
# Sibling of breezy-pm-crh-v2-tally.service: same oneshot/no-Install shape,
# same wrapper script -- only the family-id argument differs. The family id
# (kalshi_crh_v1) is the wrapper's ONLY argument; it is never inferred.
# Scheduled to run AFTER breezy-pm-crh-v2-tally (15:30 UTC), so the two
# families' reads of the shared parquet store never race each other.
#
# No network: the PREREG v2 store is a local parquet directory
# (`~/.local/share/breezy/derived/scored_trials`, same store
# breezy-live-tally.service and breezy-pm-crh-v2-tally.service read), plus
# the local family manifest (`deploy/families/kalshi_crh_v1.json`).
Description=Breezy PREREG v2 family tally -- kalshi_crh_v1 (daily)
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/analysis/family_tally_v2.py
Documentation=file:///home/jon/breezy/docs/plans/FAMILY_TALLY_V2_BLUEPRINT_2026-09-04.md

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy
UMask=0077

# No EnvironmentFile, deliberately: this unit holds no venue credential --
# it reads a local parquet directory and writes a local Markdown report,
# same posture as breezy-pm-crh-v2-tally.service.
ExecStart=/home/jon/breezy/deploy/systemd/family-tally-v2-run.sh kalshi_crh_v1

# Same budget as breezy-live-tally.service: a local parquet scan plus a
# bootstrap (BCa), well under breezy-mb-daily's network-bound budget.
TimeoutStartSec=600

# No Restart=. A missed daily run is not an incident -- tomorrow's run
# subsumes today's over the still-growing store. The timer's
# Persistent=true is what recovers a run missed across a reboot.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-kalshi-crh-tally

# NOTE: no [Install] section. This unit is started BY the timer, never
# enabled directly. `systemctl --user enable breezy-kalshi-crh-tally.timer`
# is the only thing to enable.
