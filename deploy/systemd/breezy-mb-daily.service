[Unit]
# Daily driver for M_A (ma_prelock_winner_ask_study.py, the SS2/SS3
# pre-lock winner-ask measurement) and M_B (mb_current_rung_edge_study.py,
# the current-rung archive-vs-tape edge measurement), triggered by
# breezy-mb-daily.timer. Sibling of breezy-k1-daily.service: same
# oneshot/no-Install shape, same wrapper-script driver style
# (deploy/systemd/mb-daily-run.sh mirrors k1-daily-run.sh), for the same
# reason -- the timer owns cadence, the script owns the work.
#
# Unlike K1, this unit DOES need the network: mb-daily-run.sh runs
# asos_recent_refresh.py first (Item 4's pattern, reused here) so the two
# studies' cache-only, raise-on-miss ASOS reads
# (ma_prelock_winner_ask_study.py:load_asos_series_for_day) have a
# byte-identical cache entry to read on the day this window has advanced
# past what was previously fetched -- see mb-daily-run.sh's own header for
# why `--since` (not `--lookback-days`) is what keeps the two anchors
# identical day over day.
Description=Breezy M_A + M_B tape-side measurement studies (daily)
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
Documentation=file:///home/jon/breezy/scripts/analysis/ma_prelock_winner_ask_study.py
Documentation=file:///home/jon/breezy/scripts/analysis/mb_current_rung_edge_study.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy

# Own cgroup memory ceiling. Same 2026-09-11 K1 incident
# (breezy-k1-daily.service hit a 17.6 GB peak in under 2 minutes with no
# ceiling at all, pushing the 31 GB host into swap while
# breezy-trade-supervisor.service -- the live trading node, deliberately
# left UNcapped, see its own :64 comment -- ran at ~625 MB) prompted capping
# every nightly-analysis unit. Measured via `journalctl --user -u
# breezy-mb-daily.service --since 2026-09-08 --no-pager -o cat | grep -aoE
# '[0-9.]+[MG] memory peak'`: the last three completed runs peaked at 14.3G,
# 10.1G, 11.6G over 14-35 min wall clock. MemoryHigh=12G/MemoryMax=16G
# matches the sibling tape studies: well above this unit's measured range so
# ordinary runs are never throttled or killed, and still deliberately far
# below the 31 GB host (node + recorder + tooling together measure well
# under 4G), so a genuine runaway gets OOM-killed in its OWN cgroup, never
# the host-wide OOM killer.
MemoryHigh=12G
MemoryMax=16G

# Shared aggregate ceiling across the nightly studies (see the slice file's
# own comment for why it is usually redundant with the per-unit cap above).
Slice=breezy-studies.slice
UMask=0077

# No EnvironmentFile, deliberately: neither study nor the ASOS refresh holds
# a venue credential. Both studies default their quote-tape and settlement
# catalog paths absolutely (ma_prelock_winner_ask_study.py:
# DEFAULT_QUOTE_TAPE_CATALOG, DEFAULT_SETTLEMENT_CATALOG), and the refresh
# talks only to the public IEM ASOS endpoint -- same posture as
# breezy-k1-daily.service and breezy-offer-gate-daily.service.
ExecStart=/home/jon/breezy/deploy/systemd/mb-daily-run.sh

# Double breezy-k1-daily.service's budget: this unit runs a network fetch
# across five sites PLUS two full measurement scripts in sequence, not one
# local disk-only read. For Type=oneshot this bounds the whole run.
TimeoutStartSec=3600

# No Restart=. A missed daily run is not an incident -- the tape and the
# ASOS cache keep growing, and tomorrow's run subsumes today's. The timer's
# Persistent=true is what recovers a run missed across a reboot.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-mb-daily

# NOTE: no [Install] section. This unit is started BY the timer, never
# enabled directly. `systemctl --user enable breezy-mb-daily.timer` is the
# only thing to enable.
