[Unit]
# G-14. The daily K1 study, triggered by breezy-k1-daily.timer.
# Replaces the PPID-1 `k1_daily.sh` while-loop in the /tmp session scratchpad,
# which does not survive a reboot.
Description=Breezy K1 cheap-open D+1 settlement measurement (daily)
Documentation=file:///home/jon/breezy/deploy/systemd/README.md
# Not a hard dependency: the measurement reads the tape from disk and does not
# require the recorder to be up at the moment it runs. It DOES need the
# network for nothing at all -- it is a pure local read.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jon/breezy

# Own cgroup memory ceiling. 2026-09-11 incident: this unit reached a 17.6 GB
# memory peak in under 2 minutes with NO MemoryHigh=/MemoryMax= configured at
# all, pushing the 31 GB host into swap while breezy-trade-supervisor.service
# (the live trading node, deliberately left UNcapped on purpose -- see its
# own :64 comment) was running at ~625 MB. Measured via `journalctl --user -u
# breezy-k1-daily.service --since 2026-09-08 --no-pager -o cat | grep -aoE
# '[0-9.]+[MG] memory peak'`: the last three completed runs peaked at 23.6G,
# 14.9G, 17.6G over 8-10 min wall clock -- ordinary operation of this study
# routinely runs in the 15-24G range, so a 6G ceiling would OOM-kill every
# night's legitimate run, not just a genuine runaway. MemoryHigh=12G/
# MemoryMax=16G is deliberately far below the 31 GB host (node + recorder +
# tooling together measure well under 4G), so a run that DOES exceed the
# measured range still gets OOM-killed in its OWN cgroup, never the
# host-wide OOM killer choosing among unrelated processes including the
# trading node. A streaming fix to the K1 loader is in flight separately and
# is expected to let this ceiling come down later.
MemoryHigh=12G
MemoryMax=16G

# Shared aggregate ceiling across the nightly studies (see the slice file's
# own comment for why it is usually redundant with the per-unit cap above).
Slice=breezy-studies.slice
UMask=0077

# No EnvironmentFile. Deliberate, and the point of the separation: this
# process holds NO venue credential and opens no socket. It reads the quote
# tape and the NWS settlement catalog from disk, both of which it defaults to
# absolutely (scripts/analysis/k1_cheap_open_settlement.py:143-146), so it can
# run on a host with no Polymarket.us configuration at all.
ExecStart=/home/jon/breezy/deploy/systemd/k1-daily-run.sh

# Mirrors the `timeout 1800` the stopgap driver wrapped the run in
# (k1_daily.sh:21). For Type=oneshot this bounds the whole run.
TimeoutStartSec=1800

# No Restart=. A missed daily measurement is not an incident -- the tape keeps
# growing and tomorrow's run subsumes today's. The timer's Persistent=true is
# what recovers a run missed across a reboot.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=breezy-k1-daily

# NOTE: no [Install] section. This unit is started BY the timer, never
# enabled directly. `systemctl --user enable breezy-k1-daily.timer` is the
# only thing to enable.
